---
import type { Lang } from '../i18n/content';
import { fpgaDemo } from '../i18n/fpga-demo';
import { DIGITS } from '../scripts/fpga-game';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = fpgaDemo[lang];

/** Polygones des segments a à g dans un afficheur de 60 × 100. */
const SEGMENTS: Record<string, string> = {
  a: '12,6 48,6 42,13 18,13',
  b: '50,8 56,14 56,46 50,50 44,44 44,16',
  c: '50,54 56,58 56,90 50,96 44,84 44,56',
  d: '12,94 48,94 42,87 18,87',
  e: '10,54 16,56 16,84 10,96 4,90 4,58',
  f: '10,8 16,16 16,44 10,50 4,46 4,14',
  g: '12,50 18,44 42,44 48,50 42,56 18,56',
};
---

<div class="fpga-demo" data-fpga-demo>
  <h4 class="fd-title">{c.title}</h4>
  <p class="fd-note">{c.note}</p>

  <div class="fd-board" tabindex="0" aria-describedby="fd-keys">
    <svg class="fd-display" viewBox={`0 0 ${DIGITS * 64} 100`} role="img" aria-label={c.display}>
      {
        Array.from({ length: DIGITS }, (_, d) => (
          <g transform={`translate(${d * 64 + 2} 0)`} data-digit={d}>
            {Object.entries(SEGMENTS).map(([k, pts]) => (
              <polygon class="seg" data-seg={k} points={pts} />
            ))}
          </g>
        ))
      }
    </svg>

    <ol class="fd-leds" role="img" aria-label={c.leds}>
      {Array.from({ length: 10 }, (_, i) => <li data-led={i}><span>{9 - i}</span></li>)}
    </ol>

    <div class="fd-row">
      <button type="button" class="fd-sw" data-sw="3" aria-pressed="false">{c.power}</button>
      <div class="fd-group" role="group" aria-label={c.difficulty}>
        <button type="button" class="fd-sw" data-sw="0" aria-pressed="false">{c.levels[0]}</button>
        <button type="button" class="fd-sw" data-sw="1" aria-pressed="false">{c.levels[1]}</button>
        <button type="button" class="fd-sw" data-sw="2" aria-pressed="false">{c.levels[2]}</button>
      </div>
    </div>

    <div class="fd-row fd-keys-row">
      <button type="button" class="fd-key" data-act="start">{c.start}</button>
      <button type="button" class="fd-key" data-act="up">{c.up}</button>
      <button type="button" class="fd-key" data-act="down">{c.down}</button>
      <button type="button" class="fd-key" data-act="reset">{c.reset}</button>
    </div>
  </div>

  <p class="fd-hint" id="fd-keys" aria-live="polite">{c.hint} <span>{c.keys}</span></p>
</div>

<style is:global>
  .fpga-demo { margin-top: 1.25rem; padding: 1rem; border: 1px solid var(--line, currentColor); border-radius: 0.5rem; }
  .fd-title { margin: 0 0 0.25rem; }
  .fd-note, .fd-hint { font-size: 0.85rem; opacity: 0.8; margin: 0.25rem 0 0.75rem; }
  .fd-hint span { display: block; }
  .fd-board { display: grid; gap: 0.75rem; padding: 0.75rem; background: #0b0e11; border-radius: 0.5rem; color: #e6e6e6; }
  .fd-board:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  .fd-display { width: 100%; max-width: 32rem; margin: 0 auto; display: block; }
  .fd-display .seg { fill: #2a1414; transition: fill 60ms; }
  .fd-display .seg.on { fill: #ff3b30; }
  .fd-leds { display: flex; gap: 0.35rem; list-style: none; padding: 0; margin: 0; justify-content: center; }
  .fd-leds li { width: 0.9rem; height: 0.9rem; border-radius: 50%; background: #3a1a1a; position: relative; }
  .fd-leds li.on { background: #ff3b30; box-shadow: 0 0 6px #ff3b30; }
  .fd-leds li span { position: absolute; top: 1.1rem; left: 50%; transform: translateX(-50%); font: 0.6rem/1 ui-monospace, monospace; opacity: 0.6; }
  .fd-row { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-top: 0.6rem; }
  .fd-group { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .fd-sw, .fd-key { min-height: 2.75rem; padding: 0 0.9rem; border-radius: 0.4rem; border: 1px solid #555; background: #1a1f25; color: inherit; font: inherit; font-size: 0.85rem; cursor: pointer; touch-action: manipulation; }
  .fd-sw[aria-pressed='true'] { background: #1f6f43; border-color: #3fbf7f; }
  .fd-key:active { background: #333b44; }
  .fd-sw:focus-visible, .fd-key:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
</style>

<script>
  import {
    TICK_MS, applySwitches, createGame, display, down, leds, reset, start, tick, up,
    type Switches,
  } from '../scripts/fpga-game';

  const root = document.querySelector<HTMLElement>('[data-fpga-demo]');
  if (root) {
    const g = createGame();
    const sw: Switches = { sw0: false, sw1: false, sw2: false, sw3: false };
    const digits = [...root.querySelectorAll<SVGGElement>('[data-digit]')];
    const ledEls = [...root.querySelectorAll<HTMLElement>('[data-led]')];
    const swBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-sw]')];
    let timer = 0;
    let timerMs = 0;

    const render = (): void => {
      const d = display(g);
      digits.forEach((el, i) => {
        const mask = d[i] ?? 0;
        el.querySelectorAll<SVGPolygonElement>('.seg').forEach((p, k) => p.classList.toggle('on', (mask & (1 << k)) !== 0));
      });
      leds(g).forEach((v, i) => ledEls[i]?.classList.toggle('on', v));
      swBtns.forEach((b) => b.setAttribute('aria-pressed', String(sw[`sw${b.dataset['sw']}` as keyof Switches])));
    };

    const schedule = (): void => {
      const ms = g.state === 'running' && g.difficulty ? TICK_MS[g.difficulty] : 0;
      if (ms === timerMs) return;
      window.clearInterval(timer);
      timerMs = ms;
      if (ms > 0) timer = window.setInterval(() => { tick(g); render(); schedule(); }, ms);
    };

    const update = (): void => { render(); schedule(); };

    swBtns.forEach((b) =>
      b.addEventListener('click', () => {
        const key = `sw${b.dataset['sw']}` as keyof Switches;
        if (key === 'sw3') sw.sw3 = !sw.sw3;
        else {
          // un seul interrupteur de difficulté actif à la fois pour rester lisible ; la priorité reste testée côté logique
          const was = sw[key];
          sw.sw0 = sw.sw1 = sw.sw2 = false;
          sw[key] = !was;
        }
        applySwitches(g, sw);
        update();
      }),
    );

    const act: Record<string, () => void> = { start: () => start(g), up: () => up(g), down: () => down(g), reset: () => reset(g) };
    root.querySelectorAll<HTMLButtonElement>('[data-act]').forEach((b) =>
      b.addEventListener('click', () => { act[b.dataset['act'] ?? '']?.(); update(); }),
    );

    // Clavier : uniquement quand le focus est dans la démo, pour ne pas bloquer le défilement de la page.
    root.addEventListener('keydown', (e) => {
      const map: Record<string, string> = { ArrowUp: 'up', ArrowDown: 'down', r: 'reset', R: 'reset' };
      const target = e.target as HTMLElement;
      const name = e.key === ' ' && !(target instanceof HTMLButtonElement) ? 'start' : map[e.key];
      if (!name) return;
      e.preventDefault();
      act[name]?.();
      update();
    });

    // Pas de timer actif si le panneau est replié.
    const details = root.closest('details');
    details?.addEventListener('toggle', () => {
      if (!details.open) { window.clearInterval(timer); timerMs = 0; if (g.state === 'running') g.state = 'menu'; update(); }
    });

    update();
  }
</script>
