---
import { LANGS, content, type Lang } from '../i18n/content';
import { SITE, url } from '../site';
import { cvUrl } from '../cv';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const links = [
  ['path', t.nav.path],
  ['skills', t.nav.skills],
  ['projects', t.nav.projects],
  ['contact', t.nav.contact],
] as const;
const cv = cvUrl(lang);
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="#top">{SITE.name}</a>
    <nav class="site-nav" aria-label={t.nav.label}>
      {links.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      {cv && <a class="nav-cv" href={cv} download data-goatcounter-click="cv-download" data-goatcounter-title="CV">{content[lang].cv}</a>}
    </nav>
    <ul class="langs" aria-label={t.nav.language}>
      {
        LANGS.map((l) => (
          <li>
            <a
              href={url(`${l}/`)}
              lang={l}
              hreflang={l}
              title={content[l].localeName}
              aria-current={l === lang ? 'true' : undefined}
            >
              {l.toUpperCase()}
            </a>
          </li>
        ))
      }
    </ul>
    <button class="theme-toggle" type="button" aria-label={t.nav.theme} title={t.nav.theme}>
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
    </button>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset['theme'] === 'light' ? 'dark' : 'light';
      root.dataset['theme'] = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* stockage indisponible : le choix vaut pour cette page seulement */
      }
    });
  });
</script>
