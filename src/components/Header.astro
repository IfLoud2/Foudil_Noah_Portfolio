---
import { LANGS, content, type Lang } from '../i18n/content';
import { SITE, url } from '../site';
import { cvUrl } from '../cv';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const links = [
  ['skills', t.nav.skills],
  ['bench', t.nav.bench],
  ['projects', t.nav.projects],
  ['path', t.nav.path],
  ['contact', t.nav.contact],
] as const;
const cv = cvUrl(lang);
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="#top">{SITE.name}</a>
    <nav class="site-nav" aria-label={t.nav.label}>
      {links.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      {cv && <a class="nav-cv" href={cv} download>{content[lang].cv}</a>}
    </nav>
    <ul class="langs" aria-label={t.nav.language}>
      {
        LANGS.map((l) => (
          <li>
            <a
              href={url(`${l}/`)}
              lang={l}
              hreflang={l}
              title={content[l].localeName}
              aria-current={l === lang ? 'true' : undefined}
            >
              {l.toUpperCase()}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>
