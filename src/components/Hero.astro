---
import { content, type Lang } from '../i18n/content';
import { SITE } from '../site';
import { cvUrl } from '../cv';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang].hero;
const [first = SITE.name, ...rest] = SITE.name.split(' ');
const last = rest.join(' ');
const cv = cvUrl(lang);
---

<section class="hero" id="top" data-lidar>
  <div class="lidar-canvas" data-lidar-canvas role="img" tabindex="0" aria-label={t.canvasLabel}></div>
  <div class="wrap hero-inner">
    <h1 class="hero-name" aria-label={SITE.name}>
      <span class="line" aria-hidden="true"><span>{first}</span></span>
      {last && <span class="line" aria-hidden="true"><span>{last}</span></span>}
    </h1>
    <p class="hero-role">{t.role}</p>
    <p class="hero-intro">{t.intro}</p>
    <div class="hero-actions">
      <a class="button" href="#skills">{t.cta}</a>
      {cv && <a class="button ghost" href={cv} download>{content[lang].cv}</a>}
    </div>
  </div>
  <div class="hero-demo">
    <dl class="hud" aria-hidden="true">
      <div>
        <dt>{t.hud.altitude}</dt>
        <dd data-hud="alt">0.00 m</dd>
      </div>
      <div>
        <dt>{t.hud.heading}</dt>
        <dd data-hud="yaw">0°</dd>
      </div>
      <div>
        <dt>{t.hud.points}</dt>
        <dd data-hud="pts">0</dd>
      </div>
    </dl>
    <p class="demo-caption">{t.demoCaption}</p>
    <p class="drag-hint" aria-hidden="true">{t.hint}</p>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-lidar]');
  if (root) {
    const start = (): void => {
      import('../scripts/lidar.ts')
        .then((m) => m.startLidar(root))
        .catch(() => root.classList.add('is-static'));
    };
    if (document.readyState === 'complete') window.setTimeout(start, 50);
    else window.addEventListener('load', () => window.setTimeout(start, 100), { once: true });
  }
</script>
