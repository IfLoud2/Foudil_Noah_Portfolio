---
// Planche de dessin technique en arrière-plan de l'intro : une vue éclatée par projet, tracée « à la main ».
// Décoratif uniquement (aria-hidden) ; le trait se dessine une fois, puis la planche reste fixe.
interface Props {
  name: string;
}
const { name } = Astro.props;

// ---- projection isométrique (x vers la droite-bas, y vers la gauche-bas, z vers le haut) ----
type Pt = [number, number];
const iso = (x: number, y: number, z: number): Pt => [(x - y) * 0.866, (x + y) * 0.5 - z];
const f = (n: number): string => n.toFixed(1);
const pt = (p: Pt): string => `${f(p[0])} ${f(p[1])}`;
const line = (...ps: Pt[]): string => ps.map((p, i) => `${i === 0 ? 'M' : 'L'}${pt(p)}`).join(' ');

interface Shape {
  fill: string;
  edge: string;
}

/** Parallélépipède : silhouette (pour masquer ce qui est derrière) + arêtes visibles. */
function box(x0: number, y0: number, z0: number, w: number, d: number, h: number): Shape {
  const x1 = x0 + w;
  const y1 = y0 + d;
  const z1 = z0 + h;
  const A = iso(x0, y0, z1), B = iso(x1, y0, z1), C = iso(x1, y1, z1), D = iso(x0, y1, z1);
  const E = iso(x1, y0, z0), F = iso(x1, y1, z0), G = iso(x0, y1, z0);
  return {
    fill: `${line(A, B, E, F, G, D)} Z`,
    edge: `${line(A, B, C, D)} Z ${line(B, E)} ${line(C, F)} ${line(D, G)} ${line(E, F, G)}`,
  };
}

/** Cylindre d'axe vertical. */
function cyl(cx: number, cy: number, z0: number, r: number, h: number): Shape {
  const [x, yt] = iso(cx, cy, z0 + h);
  const yb = iso(cx, cy, z0)[1];
  const rx = r * 1.2247;
  const ry = r * 0.7071;
  const top = `M${f(x - rx)} ${f(yt)} a${f(rx)} ${f(ry)} 0 1 0 ${f(2 * rx)} 0 a${f(rx)} ${f(ry)} 0 1 0 ${f(-2 * rx)} 0`;
  return {
    fill: `M${f(x - rx)} ${f(yt)} V${f(yb)} A${f(rx)} ${f(ry)} 0 0 0 ${f(x + rx)} ${f(yb)} V${f(yt)} A${f(rx)} ${f(ry)} 0 0 0 ${f(x - rx)} ${f(yt)} Z`,
    edge: `${top} M${f(x - rx)} ${f(yt)} V${f(yb)} M${f(x + rx)} ${f(yt)} V${f(yb)} M${f(x - rx)} ${f(yb)} A${f(rx)} ${f(ry)} 0 0 0 ${f(x + rx)} ${f(yb)}`,
  };
}

/** Ellipse horizontale (disque d'hélice, cercle de perçage…). */
function disc(cx: number, cy: number, z: number, r: number): string {
  const [x, y] = iso(cx, cy, z);
  const rx = r * 1.2247;
  const ry = r * 0.7071;
  return `M${f(x - rx)} ${f(y)} a${f(rx)} ${f(ry)} 0 1 0 ${f(2 * rx)} 0 a${f(rx)} ${f(ry)} 0 1 0 ${f(-2 * rx)} 0`;
}

/** Axes d'assemblage en pointillés, dans les intervalles entre les pièces. */
const axis = (x: number, y: number, spans: [number, number][]): string =>
  spans.map(([a, b]) => line(iso(x, y, a), iso(x, y, b))).join(' ');

interface Call {
  n: number;
  from: Pt;
  to: Pt;
}
const calls = (list: Call[]): { leader: string; boxes: { x: number; y: number; n: number }[] } => ({
  leader: list.map((c) => line(c.from, c.to)).join(' '),
  boxes: list.map((c) => ({ x: c.to[0], y: c.to[1], n: c.n })),
});

// ---- 1. Drone : vue éclatée le long de l'axe vertical ----
const uavParts: Shape[] = [
  box(-26, -14, 0, 52, 28, 12), // batterie
  box(-80, -6, 46, 160, 12, 4), // bras X
  box(-6, -80, 46, 12, 160, 4), // bras Y
  box(-24, -24, 46, 48, 48, 4), // platine
  cyl(80, 0, 50, 9, 14),
  cyl(-80, 0, 50, 9, 14),
  cyl(0, 80, 50, 9, 14),
  cyl(0, -80, 50, 9, 14), // moteurs
  box(-18, -18, 88, 36, 36, 3), // contrôleur de vol
  box(-30, -14, 114, 60, 28, 3), // Raspberry Pi Zero 2W
  cyl(0, 0, 138, 16, 16), // LD19
];
const uavTop = cyl(0, 0, 138, 7, 0).edge;
const uavProps = [disc(80, 0, 72, 40), disc(-80, 0, 72, 40), disc(0, 80, 72, 40), disc(0, -80, 72, 40)].join(' ');
const uavAxis = axis(0, 0, [[12, 46], [50, 88], [91, 114], [117, 138], [154, 172]]);
const uavCalls = calls([
  { n: 1, from: iso(10, 10, 150), to: [110, -190] },
  { n: 2, from: iso(30, 0, 117), to: [110, -145] },
  { n: 3, from: iso(18, 8, 90), to: [110, -100] },
  { n: 4, from: iso(80, 0, 52), to: [110, -50] },
  { n: 5, from: iso(26, 0, 6), to: [110, 0] },
]);

// ---- 2. Robot : bras éclaté ----
const robotParts: Shape[] = [
  cyl(0, 0, 0, 30, 14),
  box(-18, -18, 34, 36, 36, 24),
  box(-7, -7, 80, 14, 14, 50),
  cyl(0, 0, 146, 12, 14),
  box(-6, -6, 176, 12, 12, 40),
  cyl(0, 0, 230, 9, 10),
  box(-16, -8, 252, 32, 16, 5),
  box(-14, -3, 262, 6, 6, 26),
  box(8, -3, 262, 6, 6, 26),
];
const robotAxis = axis(0, 0, [[14, 34], [58, 80], [130, 146], [160, 176], [216, 230], [240, 252]]);
const robotCalls = calls([
  { n: 1, from: iso(14, 0, 275), to: [90, -285] },
  { n: 2, from: iso(7, 0, 190), to: [90, -200] },
  { n: 3, from: iso(18, 0, 46), to: [90, -90] },
  { n: 4, from: iso(30, 0, 4), to: [90, -10] },
]);

// ---- 3. LCR-mètre : empilement de la carte ----
const hatch: string[] = [];
for (let k = -48; k <= 48; k += 12) hatch.push(line(iso(k, -34, 37), iso(k, 34, 37)));
for (let k = -30; k <= 30; k += 12) hatch.push(line(iso(-54, k, 37), iso(54, k, 37)));
const lcrParts: Shape[] = [
  box(-60, -38, 0, 120, 76, 3),
  box(-60, -38, 34, 120, 76, 2),
  box(-60, -38, 68, 120, 76, 3),
  box(-34, -6, 71, 20, 12, 3), // AD7450
  box(-6, 6, 71, 18, 12, 3), // amplificateur
  box(14, -30, 71, 40, 28, 5), // ESP32
  box(20, 12, 71, 24, 16, 3),
  cyl(-52, -18, 71, 7, 10), // BNC V
  cyl(-52, 18, 71, 7, 10), // BNC I
];
const lcrTraces = [
  line(iso(-45, -18, 71), iso(-34, -18, 71), iso(-34, 0, 71)),
  line(iso(-45, 18, 71), iso(-20, 18, 71), iso(-20, 6, 71)),
  line(iso(-14, 0, 71), iso(-2, 0, 71), iso(-2, 10, 71), iso(-6, 12, 71)),
  line(iso(12, 12, 71), iso(14, -16, 71)),
].join(' ');
const lcrVias = [[-56, -34], [56, -34], [56, 34], [-56, 34]]
  .map(([x, y]) => axis(x as number, y as number, [[3, 34], [36, 68]]))
  .join(' ');
const lcrRings = [disc(-52, -18, 81, 4), disc(-52, 18, 81, 4)].join(' ');
const lcrCalls = calls([
  { n: 1, from: iso(40, -16, 76), to: [130, -150] },
  { n: 2, from: iso(-14, 0, 74), to: [130, -105] },
  { n: 3, from: iso(-52, 18, 81), to: [-150, -105] },
  { n: 4, from: iso(54, 20, 37), to: [130, -40] },
]);
---

<svg class="sheet-draw" viewBox="0 0 1200 760" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <filter id="pencil" x="-2%" y="-2%" width="104%" height="104%">
      <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7" result="n"></feTurbulence>
      <feDisplacementMap in="SourceGraphic" in2="n" scale="2.6"></feDisplacementMap>
    </filter>
    <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 1 L10 5 L0 9" fill="none" stroke="currentColor" stroke-width="1.2"></path>
    </marker>
  </defs>

  <g filter="url(#pencil)" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <path class="d k" pathLength="1" style="--n:0" d="M24 24 H1176 V736 H24 Z"></path>

    <g class="proj" style="--n:1;--sw:1.2;--fs:1.05" transform="translate(190 262) scale(0.95)">
      {uavParts.map((p) => (<><path class="f" d={p.fill}></path><path class="d" pathLength="1" d={p.edge}></path></>))}
      <path class="d t" pathLength="1" d={uavProps}></path>
      <path class="d t" pathLength="1" d={uavAxis}></path>
      <path class="d" pathLength="1" d={uavCalls.leader}></path>
      {uavCalls.boxes.map((b) => (<g><rect class="d" pathLength="1" x={b.x} y={b.y - 8} width="16" height="16"></rect><text x={b.x + 8} y={b.y + 4} text-anchor="middle">{b.n}</text></g>))}
      <text x="20" y="38" text-anchor="middle">UAV · LD19 · Pi Zero 2W · FC</text>
    </g>

    <g class="proj" style="--n:2;--sw:2;--fs:1.45" transform="translate(600 262) scale(0.56)">
      {robotParts.map((p) => (<><path class="f" d={p.fill}></path><path class="d" pathLength="1" d={p.edge}></path></>))}
      <path class="d t" pathLength="1" d={robotAxis}></path>
      <path class="d" pathLength="1" d={robotCalls.leader}></path>
      {robotCalls.boxes.map((b) => (<g><rect class="d" pathLength="1" x={b.x} y={b.y - 8} width="16" height="16"></rect><text x={b.x + 8} y={b.y + 4} text-anchor="middle">{b.n}</text></g>))}
      <text x="40" y="44" text-anchor="middle">ROBOT · BRAS ÉCLATÉ</text>
    </g>

    <g class="proj" style="--n:3" transform="translate(960 226) scale(1)">
      {lcrParts.map((p) => (<><path class="f" d={p.fill}></path><path class="d" pathLength="1" d={p.edge}></path></>))}
      <path class="d" pathLength="1" d={lcrTraces}></path>
      <path class="d t" pathLength="1" d={hatch.join(' ')}></path>
      <path class="d t" pathLength="1" d={lcrVias}></path>
      <path class="d" pathLength="1" d={lcrRings}></path>
      <path class="d" pathLength="1" d={lcrCalls.leader}></path>
      {lcrCalls.boxes.map((b) => (<g><rect class="d" pathLength="1" x={b.x} y={b.y - 8} width="16" height="16"></rect><text x={b.x + 8} y={b.y + 4} text-anchor="middle">{b.n}</text></g>))}
      <text x="0" y="68" text-anchor="middle">LCR-MÈTRE · PCB v3</text>
    </g>

    <g class="proj" style="--n:4" transform="translate(120 520) scale(0.8)">
      <path class="d" pathLength="1" d="M0 60 H60 L72 36 L90 84 L108 36 L126 84 L138 60 H220 V100 M220 100 H260 M190 100 H290 M200 112 H280 M212 124 H268 M220 124 V150"></path>
      <path class="d" pathLength="1" d="M220 60 H320"></path>
      <path class="d" pathLength="1" d="M0 200 H320 M200 200 V176 M240 200 V180"></path>
      <path class="d t" pathLength="1" d="M0 60 V200 M320 60 V200"></path>
      <text x="62" y="26">R</text>
      <text x="296" y="106">C</text>
      <text x="4" y="236">HVDC · FILTRE RC</text>
    </g>

    <g class="proj" style="--n:5" transform="translate(480 530) scale(0.8)">
      <path class="d" pathLength="1" d="M0 70 H20 V30 H60 V70 H100 V30 H140 V70 H180 V30 H220 V70 H260 V30 H300"></path>
      <path class="d" pathLength="1" d="M0 140 H70 L84 110 H190 L204 140 H300"></path>
      <path class="d" pathLength="1" d="M0 200 H110 V170 H210 V200 H300"></path>
      <path class="d t" pathLength="1" d="M60 10 V220 M140 10 V220 M220 10 V220"></path>
      <text x="4" y="22">CLK</text>
      <text x="4" y="236">FPGA · VHDL</text>
    </g>

    <g class="proj" style="--n:6" transform="translate(880 560) scale(0.85)">
      <rect class="d" pathLength="1" x="0" y="0" width="270" height="150"></rect>
      <path class="d" pathLength="1" d="M0 50 H270 M0 100 H270 M170 100 V150"></path>
      <text class="big" x="14" y="34">{name.toUpperCase()}</text>
      <text x="14" y="82">PORTFOLIO · 5 PROJETS</text>
      <text x="14" y="130">ÉCH. 1:1</text>
      <text x="184" y="130">PL. 1/1</text>
    </g>
  </g>
</svg>
