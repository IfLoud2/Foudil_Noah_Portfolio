---
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang].skills;
const projects = content[lang].projects.items;
const shortOf = (id: string): string => projects.find((p) => p.id === id)?.short ?? id;
---

<section id="skills" class="wrap sheet skills" aria-labelledby="skills-title">
  <div class="rail">
    <h2 id="skills-title">{t.heading}</h2>
    <p>{t.rail}</p>
  </div>
  <div class="skills-main">
    {/* Filtre sans JavaScript : boutons radio, et :has() dans le CSS pour estomper le reste. */}
    <fieldset class="filter">
      <legend>{t.filterLabel}</legend>
      <div class="chips">
        <input type="radio" name="role-filter" id="rf-all" checked />
        <label for="rf-all">{t.filterAll}</label>
        {
          t.roleList.map((r) => (
            <>
              <input type="radio" name="role-filter" id={`rf-${r.id}`} />
              <label for={`rf-${r.id}`}>{r.label}</label>
            </>
          ))
        }
      </div>
    </fieldset>

    <div class="caps">
      {
        t.capabilities.map((cap) => (
          <article class="cap" data-roles={cap.roles.join(' ')}>
            <h3>{cap.title}</h3>
            <p class="cap-statement">{cap.statement}</p>
            <ul class="evidence">
              {cap.evidence.map((e) => (
                <li class="ev" data-p={e.project}>
                  <a class="ev-p" href={`#${e.project}`}>
                    {shortOf(e.project)}
                  </a>
                  <span>{e.text}</span>
                </li>
              ))}
            </ul>
            <ul class="tools">{cap.tools.map((tool) => <li>{tool}</li>)}</ul>
          </article>
        ))
      }
    </div>

    <h3 class="sub">{t.toolboxTitle}</h3>
    <div class="skill-groups">
      {
        t.groups.map((group) => (
          <div class="skill-group">
            <h4>{group.title}</h4>
            <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
          </div>
        ))
      }
    </div>

    <div class="about">
      <div>
        <h3 class="sub">{t.educationTitle}</h3>
        <ul>
          {
            t.education.map((e) => (
              <li>
                {e.title}
                <br />
                <span class="muted">
                  {e.place}, {e.year}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3 class="sub">{t.languagesTitle}</h3>
        <p>{t.languages}</p>
      </div>
    </div>
  </div>
</section>

<script>
  // Anime le réordonnancement des cartes quand on change de projet (technique FLIP).
  // Sans JavaScript, le filtre fonctionne quand même : seul le mouvement disparaît.
  const section = document.getElementById('skills');
  const grid = section?.querySelector<HTMLElement>('.caps');
  if (section && grid) {
    const cards = [...grid.querySelectorAll<HTMLElement>('.cap')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const measure = (): Map<HTMLElement, DOMRect> => new Map(cards.map((c) => [c, c.getBoundingClientRect()]));
    let before = measure();
    window.addEventListener('resize', () => {
      before = measure();
    });
    section.addEventListener('change', (event) => {
      if (!(event.target instanceof HTMLInputElement) || event.target.name !== 'role-filter') return;
      const after = measure();
      if (!reduced.matches) {
        for (const card of cards) {
          const a = before.get(card);
          const b = after.get(card);
          if (!a || !b) continue;
          const dx = a.left - b.left;
          const dy = a.top - b.top;
          if (dx === 0 && dy === 0) continue;
          card.animate(
            [{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'none' }],
            { duration: 450, easing: 'cubic-bezier(0.2, 0.75, 0.1, 1)' },
          );
        }
      }
      before = after;
    });
  }
</script>
