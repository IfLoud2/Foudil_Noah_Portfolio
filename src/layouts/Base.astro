---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { LANGS, content, type Lang } from '../i18n/content';
import { url } from '../site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const abs = (path: string): string => (Astro.site ? new URL(path, Astro.site).href : path);
const locale: Record<Lang, string> = { en: 'en_US', fr: 'fr_BE', nl: 'nl_BE' };
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#0b0e14" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      try {
        var th = localStorage.getItem('theme');
        if (th !== 'light' && th !== 'dark') th = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = th;
      } catch (e) {}
    </script>
    <link rel="canonical" href={abs(url(`${lang}/`))} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(url(`${l}/`))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(url('en/'))} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={abs(url(`${lang}/`))} />
    <meta property="og:locale" content={locale[lang]} />
    <script is:inline data-goatcounter="https://ifloud2.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <slot />
  </body>
</html>
